# Куда доставлять локальные сборки. Скопируйте в telegram.env и впишите значения.
# telegram.env в .gitignore — токен в репозиторий не попадает.
#
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_ID    — id чата (личка — положительный, группа — -100…).
#   Узнать: написать боту, открыть
#   https://api.telegram.org/bot<TOKEN>/getUpdates и взять result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
