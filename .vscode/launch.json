{
  // The app reads the server base URL from `SHADO_API_BASE_URL`
  // (see lib/core/config/app_config.dart). Without the flag it is production,
  // so local development configurations pass the address explicitly.
  //
  // `program` is set on every configuration on purpose: without it the Dart extension
  // runs the active editor file, and with a `*_test.dart` open the tests start
  // instead of the app.
  "version": "0.2.0",
  "configurations": [
    {
      // Production server — same as a build without flags.
      "name": "shado (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      // Inside the Android emulator the host machine is 10.0.2.2:
      // 127.0.0.1 there points to the emulator itself.
      "name": "shado (local server, Android emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=SHADO_API_BASE_URL=http://10.0.2.2:8080"]
    },
    {
      // Windows/Linux/macOS and the iOS simulator reach loopback directly.
      "name": "shado (local server, desktop / iOS simulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=SHADO_API_BASE_URL=http://127.0.0.1:8080"]
    },
    {
      "name": "shado (profile mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      // The only mode that checks the real TLS chain: the cleartext HTTP
      // allowance lives only in the Android debug manifest.
      "name": "shado (release mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ]
}
